{
  "name": "driveready-workspace",
  "private": true,
  "scripts": {
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "build:backend": "npm --prefix backend run build",
    "mobile": "npm --prefix mobile start",
    "ios": "npm --prefix mobile run ios",
    "test": "npm run test:backend",
    "test:backend": "npm --prefix backend run test",
    "typecheck": "npm run typecheck:backend && npm run typecheck:mobile",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:mobile": "npm --prefix mobile run typecheck",
    "test:mobile": "npm --prefix mobile run test"
  }
}
